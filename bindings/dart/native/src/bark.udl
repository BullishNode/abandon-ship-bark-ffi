// UniFFI Definition Language for Bark
namespace bark {
    [Throws=BarkError]
    string generate_mnemonic();

    [Throws=BarkError]
    boolean validate_mnemonic(string mnemonic);

    [Throws=BarkError]
    boolean validate_ark_address(string address);
};

// ============================================================================
// Enums
// ============================================================================

/// Bitcoin network types
enum Network {
    "Bitcoin",
    "Testnet",
    "Signet",
    "Regtest",
};

/// Error types that can occur when using the Bark wallet
[Error]
interface BarkError {
    Network(string error_message);
    Database(string error_message);
    InvalidMnemonic(string error_message);
    InvalidAddress(string error_message);
    InvalidInvoice(string error_message);
    InsufficientFunds(string error_message);
    NotFound(string error_message);
    ServerConnection(string error_message);
    Internal(string error_message);
    OnchainWalletRequired(string error_message);
};

// ============================================================================
// Records (Data Structures)
// ============================================================================

/// Configuration for creating/opening a Bark wallet
dictionary Config {
    /// Ark server address
    string server_address;

    /// Esplora HTTP REST server address
    string? esplora_address;

    /// Bitcoind RPC server address
    string? bitcoind_address;

    /// Bitcoind RPC cookie file path
    string? bitcoind_cookiefile;

    /// Bitcoind RPC username
    string? bitcoind_user;

    /// Bitcoind RPC password
    string? bitcoind_pass;

    /// Bitcoin network
    Network network;

    /// Number of blocks before expiration to refresh VTXOs
    u32? vtxo_refresh_expiry_threshold;

    /// Upper limit of blocks needed to safely exit VTXOs
    u16? vtxo_exit_margin;

    /// Number of blocks to claim a HTLC-recv VTXO
    u16? htlc_recv_claim_delta;

    /// Fallback fee rate in sat/kWu
    u64? fallback_fee_rate;

    /// Confirmations required before considering a round tx fully confirmed
    u32? round_tx_required_confirmations;
};

/// Read-only properties of the wallet
dictionary WalletProperties {
    Network network;
    string fingerprint;
};

/// Detailed balance breakdown of the wallet
dictionary Balance {
    /// Spendable off-chain balance (Ark) in sats
    u64 spendable_sats;

    /// Coins locked in a round
    u64 pending_in_round_sats;

    /// Coins being unilaterally exited
    u64 pending_exit_sats;

    /// Coins pending as Lightning sends
    u64 pending_lightning_send_sats;

    /// Claimable pending Lightning receives
    /// Note: Bark only tracks claimable receives, not total pending.
    /// The upstream Balance struct only provides claimable_lightning_receive.
    u64 claimable_lightning_receive_sats;

    /// Coins pending board confirmations
    u64 pending_board_sats;
};

/// Simplified view of a VTXO
dictionary Vtxo {
    /// VTXO id like "686...9aa:0"
    string id;

    /// Amount in sats
    u64 amount_sats;

    /// Expiry height (0 if unknown)
    u32 expiry_height;

    /// Type of VTXO (e.g., "board", "round", "arkoor")
    string kind;

    /// State of VTXO (e.g., "spendable", "spent", "locked")
    string state;
};

/// Result of creating a BOLT11 invoice
dictionary LightningInvoice {
    /// The BOLT11 invoice string
    string invoice;

    /// Amount in sats
    u64 amount_sats;
};

/// Result of a successful lightning payment
dictionary LightningPaymentResult {
    /// The invoice that was paid
    string invoice;

    /// Payment preimage as hex string
    string preimage;
};

/// Result of an offboard operation
dictionary OffboardResult {
    /// The round ID
    string round_id;
};

/// An Ark address with its derivation index
dictionary AddressWithIndex {
    /// The Ark address string
    string address;

    /// The derivation index
    u32 index;
};

/// Status of a pending Lightning receive
dictionary LightningReceiveStatus {
    /// Payment hash
    string payment_hash;

    /// The BOLT11 invoice
    string invoice;

    /// Amount in sats
    u64 amount_sats;

    /// Whether HTLC VTXOs have been received
    boolean has_htlc_vtxos;

    /// Whether preimage has been revealed
    boolean preimage_revealed;
};

/// Status of a pending Lightning send
dictionary LightningSendStatus {
    /// The invoice being paid
    string invoice;

    /// Amount in sats
    u64 amount_sats;

    /// Number of HTLC VTXOs locked
    u32 htlc_vtxo_count;
};

/// Wallet movement/transaction record
dictionary Movement {
    /// Movement ID
    u32 id;

    /// Status (pending, finished, failed, cancelled)
    string status;

    /// Subsystem name
    string subsystem_name;

    /// Subsystem kind
    string subsystem_kind;

    /// Metadata as JSON string
    string metadata_json;

    /// Intended balance change in sats
    i64 intended_balance_sats;

    /// Effective balance change in sats
    i64 effective_balance_sats;

    /// Offchain fee in sats
    u64 offchain_fee_sats;

    /// Addresses/invoices sent to
    sequence<string> sent_to_addresses;

    /// Addresses/invoices received on
    sequence<string> received_on_addresses;

    /// Input VTXO IDs
    sequence<string> input_vtxo_ids;

    /// Output VTXO IDs
    sequence<string> output_vtxo_ids;

    /// Created at timestamp
    string created_at;

    /// Updated at timestamp
    string updated_at;

    /// Completed at timestamp (null if not completed)
    string? completed_at;
};

/// Onchain Bitcoin wallet balance
dictionary OnchainBalance {
    /// Confirmed balance in sats
    u64 confirmed_sats;

    /// Pending balance (trusted + untrusted) in sats
    u64 pending_sats;

    /// Total balance in sats
    u64 total_sats;
};

/// Pending board transaction information
dictionary PendingBoard {
    /// VTXO ID that will be created once board is registered
    string vtxo_id;

    /// Amount being boarded in sats
    u64 amount_sats;

    /// On-chain transaction ID
    string txid;
};

/// Ark server configuration information
dictionary ArkInfo {
    /// The bitcoin network the server operates on
    Network network;

    /// The Ark server pubkey as hex string
    string server_pubkey;

    /// The interval between each round in seconds
    u64 round_interval_secs;

    /// Number of nonces per round
    u32 nb_round_nonces;

    /// Delta between exit confirmation and coins becoming spendable
    u32 vtxo_exit_delta;

    /// Expiration delta of the VTXO
    u32 vtxo_expiry_delta;

    /// The number of blocks after which an HTLC-send VTXO expires once granted
    u32 htlc_send_expiry_delta;

    /// The number of blocks to keep between Lightning and Ark HTLCs expiries
    u32 htlc_expiry_delta;

    /// Maximum amount of a VTXO in sats (null if no limit)
    u64? max_vtxo_amount_sats;

    /// The number of confirmations required to register a board vtxo
    u32 required_board_confirmations;

    /// Maximum CLTV delta server will allow clients to request an invoice generation with
    u16 max_user_invoice_cltv_delta;

    /// Minimum amount for a board the server will cosign in sats
    u64 min_board_amount_sats;

    /// Offboard fee rate in sats per vbyte
    u64 offboard_feerate_sat_per_vb;

    /// Whether the Ark server requires anti-DoS measures for lightning receives
    boolean ln_receive_anti_dos_required;
};

// ============================================================================
// Onchain Wallet Callback Types
// ============================================================================

/// A Bitcoin transaction output destination
dictionary Destination {
    string address;
    u64 amount_sats;
};

/// A Bitcoin transaction outpoint (reference to a previous output)
dictionary OutPoint {
    string txid;
    u32 vout;
};

/// Reference to a block in the blockchain
dictionary BlockRef {
    u32 height;
    string hash;
};

/// Parameters for creating a CPFP (Child Pays For Parent) transaction
dictionary CpfpParams {
    /// Parent transaction to fee-bump (hex-encoded)
    string tx_hex;
    /// Fee strategy: "Effective" for normal fee, "Rbf" for replace-by-fee
    string fees_type;
    /// Target effective fee rate in sat/vB
    u64 effective_fee_rate_sat_per_vb;
    /// Current package fee in sats (only required for RBF)
    u64? current_package_fee_sats;
};

// ============================================================================
// Onchain Wallet Callback Interface
// ============================================================================

/// Callback interface for custom onchain wallet implementations
///
/// Implement this interface in Dart/Swift/Kotlin to provide your own wallet.
callback interface CustomOnchainWalletCallbacks {
    /// Get the wallet balance in satoshis
    [Throws=BarkError]
    u64 get_balance();

    /// Prepare a transaction to send to given destinations
    ///
    /// # Arguments
    /// * `destinations` - List of destinations with addresses and amounts
    /// * `fee_rate_sat_per_vb` - Fee rate in sats per vbyte
    ///
    /// # Returns
    /// Base64-encoded PSBT
    [Throws=BarkError]
    string prepare_tx(sequence<Destination> destinations, u64 fee_rate_sat_per_vb);

    /// Prepare a transaction that drains the wallet to a single address
    ///
    /// # Arguments
    /// * `address` - Bitcoin address to drain to
    /// * `fee_rate_sat_per_vb` - Fee rate in sats per vbyte
    ///
    /// # Returns
    /// Base64-encoded PSBT
    [Throws=BarkError]
    string prepare_drain_tx(string address, u64 fee_rate_sat_per_vb);

    /// Sign and finalize a PSBT
    ///
    /// # Arguments
    /// * `psbt_base64` - Base64-encoded PSBT
    ///
    /// # Returns
    /// Hex-encoded signed transaction
    [Throws=BarkError]
    string finish_tx(string psbt_base64);

    /// Get a wallet transaction by txid
    ///
    /// # Arguments
    /// * `txid` - Transaction ID as hex string
    ///
    /// # Returns
    /// Hex-encoded transaction, or null if not found
    [Throws=BarkError]
    string? get_wallet_tx(string txid);

    /// Get the block hash where a transaction was confirmed
    ///
    /// # Arguments
    /// * `txid` - Transaction ID as hex string
    ///
    /// # Returns
    /// Block reference with height and hash, or null if unconfirmed
    [Throws=BarkError]
    BlockRef? get_wallet_tx_confirmed_block(string txid);

    /// Find transaction that spends a given output
    ///
    /// # Arguments
    /// * `outpoint` - Transaction outpoint to check
    ///
    /// # Returns
    /// Hex-encoded spending transaction, or null if unspent
    [Throws=BarkError]
    string? get_spending_tx(OutPoint outpoint);

    /// Create a signed P2A CPFP transaction
    ///
    /// # Arguments
    /// * `params` - CPFP transaction parameters
    ///
    /// # Returns
    /// Hex-encoded signed CPFP transaction
    [Throws=BarkError]
    string make_signed_p2a_cpfp(CpfpParams params);

    /// Store a signed P2A CPFP transaction in the wallet
    ///
    /// # Arguments
    /// * `tx_hex` - Hex-encoded transaction
    [Throws=BarkError]
    void store_signed_p2a_cpfp(string tx_hex);
};

// ============================================================================
// Onchain Wallet Interface
// ============================================================================

/// Onchain Bitcoin wallet for boarding and exits
///
/// Supports two implementations:
/// - Default: BDK-based wallet (built-in)
/// - Custom: Your own wallet implementation via callbacks
interface OnchainWallet {
    /// Create or load an onchain wallet using a default BDK implementation shipped with Bark
    ///
    /// The wallet uses BDK for onchain operations
    /// and the same chain source configuration as the Bark wallet (esplora_address or bitcoind_*).
    [Throws=BarkError, Name=default]
    constructor(string mnemonic, Config config, string datadir);

    /// Create an onchain wallet using a custom implementation
    ///
    /// Use this when you have an existing wallet implementation in your language
    /// (Dart/Swift/Kotlin) and want to integrate it with Bark for boarding and exits.
    /// Your implementation must handle all wallet operations via the callbacks interface.
    [Throws=BarkError, Name=custom]
    constructor(CustomOnchainWalletCallbacks callbacks);

    /// Sync the onchain wallet with the blockchain
    /// Returns the amount synced in satoshis
    [Throws=BarkError]
    u64 sync();

    /// Get the onchain wallet balance
    [Throws=BarkError]
    OnchainBalance balance();

    /// Generate a new Bitcoin address
    [Throws=BarkError]
    string new_address();

    /// Send Bitcoin to an address
    /// Returns the transaction ID
    [Throws=BarkError]
    string send(string address, u64 amount_sats, u64 fee_rate_sat_per_vb);
};

// ============================================================================
// Main Wallet Interface
// ============================================================================

/// The main Bark wallet interface for Ark operations
interface Wallet {
    /// Create a new Bark wallet
    [Throws=BarkError, Name=create]
    constructor(string mnemonic, Config config, string datadir, boolean force_rescan);

    /// Open an existing Bark wallet
    [Throws=BarkError, Name=open]
    constructor(string mnemonic, Config config, string datadir);

    /// Create a new Bark wallet WITH onchain capabilities
    [Throws=BarkError, Name=create_with_onchain]
    constructor(
        string mnemonic,
        Config config,
        string datadir,
        OnchainWallet onchain_wallet,
        boolean force_rescan
    );

    /// Open an existing Bark wallet WITH onchain capabilities
    [Throws=BarkError, Name=open_with_onchain]
    constructor(
        string mnemonic,
        Config config,
        string datadir,
        OnchainWallet onchain_wallet
    );

    // ------------------------------------------------------------------------
    // Wallet Properties
    // ------------------------------------------------------------------------

    [Throws=BarkError]
    WalletProperties properties();

    // ------------------------------------------------------------------------
    // Synchronization & Maintenance
    // ------------------------------------------------------------------------

    /// Lightweight sync with Ark server and blockchain
    /// Note: Bark's sync() handles errors internally with logging.
    /// The Throws annotation is for forward compatibility only.
    [Throws=BarkError]
    void sync();

    [Throws=BarkError]
    void maintenance();

    // ------------------------------------------------------------------------
    // Address Generation
    // ------------------------------------------------------------------------

    [Throws=BarkError]
    string new_address();

    // ------------------------------------------------------------------------
    // Balance & VTXOs
    // ------------------------------------------------------------------------

    [Throws=BarkError]
    Balance balance();

    [Throws=BarkError]
    sequence<Vtxo> vtxos();

    // ------------------------------------------------------------------------
    // Offboarding (Move funds from Ark to on-chain)
    // ------------------------------------------------------------------------

    [Throws=BarkError]
    OffboardResult offboard_all(string bitcoin_address);

    // ------------------------------------------------------------------------
    // Lightning Payments (Send)
    // ------------------------------------------------------------------------

    [Throws=BarkError]
    LightningPaymentResult pay_lightning_invoice(string invoice, u64? amount_sats);

    [Throws=BarkError]
    LightningPaymentResult pay_lightning_address(
        string lightning_address,
        u64 amount_sats,
        string? comment
    );

    // ------------------------------------------------------------------------
    // Lightning Payments (Receive)
    // ------------------------------------------------------------------------

    [Throws=BarkError]
    LightningInvoice bolt11_invoice(u64 amount_sats);

    [Throws=BarkError]
    void try_claim_all_lightning_receives(boolean wait);

    // ------------------------------------------------------------------------
    // Arkoor Payments (Out-of-round Ark payments)
    // ------------------------------------------------------------------------

    [Throws=BarkError]
    string send_arkoor_payment(string ark_address, u64 amount_sats);

    // ------------------------------------------------------------------------
    // Extended Address Management
    // ------------------------------------------------------------------------

    /// Generate a new address and return it with its index
    [Throws=BarkError]
    AddressWithIndex new_address_with_index();

    /// Peek at an address at a specific index
    [Throws=BarkError]
    string peak_address(u32 index);

    // ------------------------------------------------------------------------
    // Movement History
    // ------------------------------------------------------------------------

    /// Get all wallet movements (transaction history)
    [Throws=BarkError]
    sequence<Movement> movements();

    // ------------------------------------------------------------------------
    // Extended VTXO Queries
    // ------------------------------------------------------------------------

    /// Get a specific VTXO by ID
    [Throws=BarkError]
    Vtxo get_vtxo_by_id(string vtxo_id);

    /// Get all spendable VTXOs
    [Throws=BarkError]
    sequence<Vtxo> spendable_vtxos();

    /// Get all VTXOs (including spent)
    [Throws=BarkError]
    sequence<Vtxo> all_vtxos();

    /// Get VTXOs expiring within threshold blocks
    [Throws=BarkError]
    sequence<Vtxo> get_expiring_vtxos(u32 threshold_blocks);

    /// Get VTXOs that should be refreshed
    [Throws=BarkError]
    sequence<Vtxo> get_vtxos_to_refresh();

    // ------------------------------------------------------------------------
    // Extended Offboarding
    // ------------------------------------------------------------------------

    /// Offboard specific VTXOs to a Bitcoin address
    [Throws=BarkError]
    string offboard_vtxos(sequence<string> vtxo_ids, string bitcoin_address);

    // ------------------------------------------------------------------------
    // VTXO Refresh
    // ------------------------------------------------------------------------

    /// Refresh specific VTXOs
    [Throws=BarkError]
    string? refresh_vtxos(sequence<string> vtxo_ids);

    /// Perform maintenance refresh
    [Throws=BarkError]
    string? maintenance_refresh();

    // ------------------------------------------------------------------------
    // Extended Lightning
    // ------------------------------------------------------------------------

    /// Get all pending lightning sends
    [Throws=BarkError]
    sequence<LightningSendStatus> pending_lightning_sends();

    /// Get all pending lightning receives
    [Throws=BarkError]
    sequence<LightningReceiveStatus> pending_lightning_receives();

    /// Get claimable lightning receive balance
    [Throws=BarkError]
    u64 claimable_lightning_receive_balance_sats();

    // ------------------------------------------------------------------------
    // Onchain Payments
    // ------------------------------------------------------------------------

    /// Send an onchain payment during a round
    [Throws=BarkError]
    string send_round_onchain_payment(string address, u64 amount_sats);

    // ------------------------------------------------------------------------
    // Connection & Info
    // ------------------------------------------------------------------------

    /// Get Ark server info (null if not connected)
    ArkInfo? ark_info();

    /// Get wallet config
    Config config();

    // ------------------------------------------------------------------------
    // Boarding (requires onchain wallet)
    // ------------------------------------------------------------------------

    /// Board a specific amount from onchain wallet into Ark
    [Throws=BarkError]
    PendingBoard board_amount(OnchainWallet onchain_wallet, u64 amount_sats);

    /// Board all funds from onchain wallet into Ark
    [Throws=BarkError]
    PendingBoard board_all(OnchainWallet onchain_wallet);

    /// Sync pending board transactions
    [Throws=BarkError]
    void sync_pending_boards();

    // ------------------------------------------------------------------------
    // Unilateral Exits (requires onchain wallet)
    // ------------------------------------------------------------------------

    /// Start unilateral exit for the entire wallet
    [Throws=BarkError]
    void start_exit_for_entire_wallet(OnchainWallet onchain_wallet);

    /// Sync exit state
    [Throws=BarkError]
    void sync_exits(OnchainWallet onchain_wallet);
};
